---
import BaseHead from "@/components/BaseHead.astro";
import Gallery from "@/components/Gallery.tsx";
import { getAlbums, getAlbum } from "@/lib/albums";

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album) => ({ params: { slug: album.slug } }));
}

const { slug } = Astro.params;
const album = await getAlbum(slug);
if (!album) return Astro.redirect("/");

const pageTitle = `${album.title} — Stefan Szakal`;
const pageDescription = `${album.title} — photography by Stefan Szakal.`;
---

<!doctype html>
<html lang="en">
  <BaseHead title={pageTitle} description={pageDescription} author={'Stefan Szakal'} og={'og-image.jpg'} />

  <body class="is-preload">
    <div id="wrapper">
      <Gallery images={album.photos} title={album.title} description={album.description} backHref="/" client:load />
    </div>
  </body>
</html>
