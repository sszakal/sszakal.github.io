---
import BaseHead from "@/components/BaseHead.astro";
import { getAlbums } from "@/lib/albums";

const title = "Stefan Szakal — Photography";
const description = "Photography by Stefan Szakal.";

const albums = await getAlbums();
---

<!doctype html>
<html lang="en">
  <BaseHead
    title={title}
    description={description}
    author={'Stefan Szakal'}
    og={'og-image.jpg'}
  />

  <body class="is-preload">
    <div id="wrapper">
      <div id="main">
        {
          albums.map((album) => (
            <article class="thumb">
              <a
                class="image cursor-pointer p-0"
                href={`/albums/${album.slug}/`}
                style={{ backgroundImage: `url(${album.cover.thumbnail})` }}
                aria-label={album.title}
              >
                <img src={album.cover.thumbnail} alt="" class="thumb-img" />
              </a>
              <h2>{album.title}</h2>
            </article>
          ))
        }
      </div>
    </div>

    <script>
      setTimeout(() => {
        document.body.classList.remove("is-preload");
      }, 100);
    </script>
  </body>
</html>
